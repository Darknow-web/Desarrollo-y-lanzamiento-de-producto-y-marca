{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Un solo Worker: la app web (Static Assets, modo SPA) y la API (/api/*) con Hono.
  "name": "andi-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Solo /api/* pasa primero por el Worker; lo demás es la app web.
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "ANDI_KV",
      // Pega aquí el id que devuelve: npx wrangler kv namespace create ANDI_KV
      "id": "REEMPLAZA_CON_EL_ID_DE_ANDI_KV"
    }
  ],
  "vars": {
    // Número de WhatsApp de AndiBite para pedidos: código de país + número, sin "+" ni espacios.
    "WHATSAPP_NUMBER": "51900000000",
    // Dirección pública de la app; va dentro de cada QR (https://.../c/CODIGO). Vacío = la dirección del Worker.
    "PUBLIC_URL": ""
  }
  // Secreto (no va en este archivo): npx wrangler secret put ADMIN_TOKEN
}
