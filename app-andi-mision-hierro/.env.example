# Copia este archivo como .env (no lo subas al repositorio) o usa estas variables en Cloud Run.
PORT=8080
# Dirección pública de la app: se usa en el QR de cada envase (https://.../c/CODIGO).
PUBLIC_URL=https://app.andibite.pe
# Clave del panel /admin del equipo. Usa una larga y secreta.
ADMIN_TOKEN=cambia-esta-clave
# Número de WhatsApp de AndiBite para pedidos, con código de país y sin "+".
WHATSAPP_NUMBER=51900000000
# Plan de loncheras con IA (opcional). Sin clave, la app usa su recetario.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Almacenamiento: file (archivo JSON, para pruebas) o firestore (producción en Google Cloud).
STORE=file
DATA_DIR=./data/runtime
FIRESTORE_DATABASE=
