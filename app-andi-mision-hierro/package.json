{
  "name": "andi-mision-hierro",
  "private": true,
  "version": "1.0.0",
  "description": "App web instalable de AndiBite: hierro medido por lote para padres y Misión Hierro, un modo educativo para niños.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"node --watch server/index.js\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "test": "vitest run",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "7.11.1",
    "@google/genai": "1.12.0",
    "express": "5.1.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@fontsource/baloo-2": "^5.2.5",
    "@fontsource/plus-jakarta-sans": "^5.2.5",
    "@types/node": "22.15.30",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "concurrently": "9.1.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.6.2",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
