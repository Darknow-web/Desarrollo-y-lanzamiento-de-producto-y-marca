{
  "name": "andi-app",
  "private": true,
  "version": "2.0.0",
  "description": "App web instalable de AndiBite: hierro medido por lote para padres y Misión Hierro, un modo educativo para niños. Corre en Cloudflare Workers.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"wrangler dev --local --port 8787\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "preview": "wrangler dev --local --port 8787",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "icons": "node scripts/icons.mjs",
    "capturas": "node scripts/capturas.mjs"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@fontsource/baloo-2": "^5.2.5",
    "@fontsource/nunito": "5.2.7",
    "@fontsource/plus-jakarta-sans": "^5.2.5",
    "@types/node": "22.15.30",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "concurrently": "9.1.2",
    "hono": "4.13.13",
    "motion": "12.23.24",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.6.2",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4",
    "wrangler": "4.150.0"
  }
}
