{
  // Presentación del T3 de AndiBite (Investigación de mercados cualitativa) en Cloudflare Workers.
  // El Worker (worker/index.ts) sirve dist/ desde el KV T3_ACTIVOS (worker/activos.ts).
  // Compilar: npm run build · Subir archivos: npm run subir-activos · Publicar: npm run deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "andibite-t3",
  "account_id": "c0dbf17cab3142a5bd3f0af8a450f54b",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "kv_namespaces": [
    {
      // Archivos de la presentación (dist/), subidos con: npm run subir-activos
      "binding": "T3_ACTIVOS",
      "id": "7bf7275cc3844c80a9d445b25375c364"
    }
  ]
}
