// Presentación web de AndiBite en Cloudflare Workers.
// El Worker (worker/index.ts) sirve dist/ desde el KV ACTIVOS (worker/activos.ts).
// Compilar: npm run build · Subir archivos: npm run subir-activos · Publicar: npm run deploy
// Se publica en https://andibite.cingacordova.workers.dev
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "andibite",
  "account_id": "c0dbf17cab3142a5bd3f0af8a450f54b",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "kv_namespaces": [
    {
      // Archivos de la presentación (dist/), subidos con: npm run subir-activos
      "binding": "ACTIVOS",
      "id": "685a5d6ce60244ab8cc74a19e44b115b"
    }
  ]
}
